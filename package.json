{
  "name": "contentops",
  "private": true,
  "type": "module",
  "workspaces": ["server", "web"],
  "scripts": {
    "start": "npm run build -w web && tsx server/src/index.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "npm run dev -w web",
    "typecheck": "tsc -p server && tsc -p web"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
